{
  "name": "playwright-suite",
  "version": "1.0.0",
  "description": "Modern E2E and API automation suite using Playwright + TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium tests/ui",
    "test:api": "playwright test --project=api tests/api",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.6.0"
  }
}
